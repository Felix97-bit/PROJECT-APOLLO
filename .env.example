ANTHROPIC_API_KEY=paste-your-key-here

# Spotify connector — from your Spotify Developer app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Email connector (iCloud Mail via IMAP) — your iCloud address + an app-specific password
# App password: appleid.apple.com -> Sign-In & Security -> App-Specific Passwords
IMAP_EMAIL=
IMAP_APP_PASSWORD=
IMAP_HOST=imap.mail.me.com
