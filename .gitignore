# --- Apollo: never commit these ---

# Secrets: your real Anthropic API key lives here. NEVER goes to GitHub.
.env

# Conversation memory database (private personal data, stays on this machine)
*.db

# Python virtual environment (re-created locally by setup.bat)
venv/

# Python cache files
__pycache__/
*.pyc

# Launcher log (created when run via the no-console shortcut)
*.log

# Spotify login token (sensitive — keep it local, never on GitHub)
spotify_token.json

# Knowledge base — private personal/client notes, keep local. README is committed.
knowledge/*
!knowledge/README.md
